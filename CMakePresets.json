{
  "version": 6,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "RV32 stack (everything)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/all"
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "run",
      "configurePreset": "default",
      "targets": [
        "run"
      ]
    },
    {
      "name": "verbose",
      "configurePreset": "default",
      "verbose": true
    }
  ]
}
