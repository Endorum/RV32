/* radcpp-skin d274f246 */
/* Generated by RAD C++ from radcpp.radcpp [skin] - do not edit */
QWidget { color: #e6e7ea; }
QMainWindow, QDialog, QWidget#centralwidget, QWidget#skinGallery, QWidget#skinPreviewRoot { background: #1e1f22; }
QLabel, QCheckBox, QRadioButton { background: transparent; }
QLabel:disabled, QPushButton:disabled, QLineEdit:disabled, QCheckBox:disabled { color: #929396; }
QPushButton, QToolButton { background: #2c2c2f; border: 1px solid #4a4b4e; border-radius: 6px; padding: 5px 14px; }
QPushButton:hover, QToolButton:hover { background: #37383a; }
QPushButton:default { border-color: #3d6df2; }
QPushButton:pressed, QToolButton:pressed { background: #3763dc; color: #ffffff; border-color: #3763dc; }
QPushButton:disabled { background: #323336; border-color: #4a4b4e; }
QLineEdit, QPlainTextEdit, QTextEdit, QSpinBox, QDoubleSpinBox, QDateEdit, QComboBox { background: #2c2c2f; border: 1px solid #4a4b4e; border-radius: 6px; padding: 3px 6px; selection-background-color: #3d6df2; selection-color: #ffffff; }
QLineEdit:focus, QPlainTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QDateEdit:focus, QComboBox:focus { border-color: #3d6df2; }
QCheckBox::indicator, QRadioButton::indicator { width: 14px; height: 14px; border: 1px solid #4a4b4e; background: #2c2c2f; }
QCheckBox::indicator { border-radius: 4px; }
QRadioButton::indicator { border-radius: 8px; }
QCheckBox::indicator:checked { background: #3d6df2; border-color: #3d6df2; image: url(:/radcpp/skin/check.svg); }
QRadioButton::indicator:checked { border-color: #3d6df2; image: url(:/radcpp/skin/radio.svg); }
QComboBox::drop-down { border: 0; width: 22px; subcontrol-origin: padding; subcontrol-position: right center; }
QComboBox::down-arrow, QSpinBox::down-arrow, QDoubleSpinBox::down-arrow, QDateEdit::down-arrow { image: url(:/radcpp/skin/arrow-down.svg); width: 10px; height: 10px; }
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow, QDateEdit::up-arrow { image: url(:/radcpp/skin/arrow-up.svg); width: 10px; height: 10px; }
QSpinBox::up-button, QSpinBox::down-button, QDoubleSpinBox::up-button, QDoubleSpinBox::down-button, QDateEdit::up-button, QDateEdit::down-button { border: 0; width: 18px; background: transparent; }
QListWidget, QTreeWidget, QTableWidget { background: #2c2c2f; border: 1px solid #4a4b4e; border-radius: 6px; gridline-color: #4a4b4e; }
QListWidget::item:selected, QTreeWidget::item:selected, QTableWidget::item:selected { background: #232b41; color: #e6e7ea; }
QListWidget::item, QTreeWidget::item { padding: 3px 6px; }
QHeaderView::section { background: #323336; border: 0; border-bottom: 1px solid #4a4b4e; padding: 3px 6px; color: #929396; }
QScrollBar:vertical { background: transparent; width: 10px; margin: 0; border: 0; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 0; border: 0; }
QScrollBar::handle:vertical { background: #4a4b4e; border-radius: 3px; min-height: 24px; margin: 2px; }
QScrollBar::handle:horizontal { background: #4a4b4e; border-radius: 3px; min-width: 24px; margin: 2px; }
QScrollBar::add-line, QScrollBar::sub-line { width: 0; height: 0; border: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }
QProgressBar { background: #323336; border: 0; border-radius: 6px; text-align: center; min-height: 14px; max-height: 14px; }
QProgressBar::chunk { background: #3d6df2; border-radius: 6px; }
QSlider::groove:horizontal { height: 4px; background: #4a4b4e; border-radius: 2px; }
QSlider::sub-page:horizontal { background: #3d6df2; border-radius: 2px; }
QSlider::handle:horizontal { width: 14px; margin: -6px 0; border-radius: 7px; background: #2c2c2f; border: 1px solid #4a4b4e; }
QGroupBox { border: 1px solid #4a4b4e; border-radius: 6px; margin-top: 12px; padding-top: 8px; }
QGroupBox::title { subcontrol-origin: margin; left: 8px; padding: 0 4px; color: #929396; }
QFrame[frameShape="1"], QFrame[frameShape="6"] { border: 1px solid #4a4b4e; border-radius: 6px; }
QTabWidget::pane { border: 1px solid #4a4b4e; border-radius: 6px; top: -1px; background: #2c2c2f; }
QTabBar::tab { background: transparent; padding: 5px 14px; color: #929396; border: 0; }
QTabBar::tab:selected { color: #e6e7ea; border-bottom: 2px solid #3d6df2; }
QLCDNumber { color: #3d6df2; background: #2c2c2f; border: 1px solid #4a4b4e; border-radius: 6px; }
QMenuBar { background: #1e1f22; color: #e6e7ea; }
